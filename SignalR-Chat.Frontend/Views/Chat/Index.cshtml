@using SignalR_Chat.Shared.DTOs
@model SignalR_Chat.Frontend.ViewModels.ChatViewModel
@{
    ViewData["Title"] = "Chat";
}

<div class="chat-container">
    <!-- Conversations Sidebar -->
    <aside class="chat-sidebar">
        <div class="sidebar-header">
            <h5>
                <i class="bi bi-chat-square-text"></i>
                Conversations
            </h5>
            
            <button class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        
        <div class="conversation-list">
            <button class="conversation-item active">
                <div>
                    <strong>General</strong>
                    
                    <small>Public Chat</small>
                </div>
            </button>
            
            <button class="conversation-item">
                <div>
                    <strong>Bob</strong>
                    
                    <small>Direct Message</small>
                </div>
            </button>
            
            <button class="conversation-item">
                <div>
                    <strong>Development</strong>
                    
                    <small>Group Chat</small>
                </div>
            </button>
        </div>
    </aside>
    
    <!-- Main Chat -->
    <section class="chat-main">
        <div class="chat-header">
            <div>
                <h5>@Model.CurrentConversation.Name</h5>
                
                <small class="text-muted">Public Conversation</small>
            </div>
            
            <button class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-three-dots"></i>
            </button>
        </div>
        
        <div class="chat-messages" id="messages">
            @foreach (MessageDto message in Model.CurrentConversation.Messages)
            {
                <div class="message">
                    <div class="message-header">
                        <strong>@message.SenderUsername</strong>
                        
                        <span>@message.SentAt.ToString("g")</span>
                    </div>
                    
                    <div class="message-content">
                        @message.Content
                    </div>
                </div>
            }
        </div>
        
        <div class="chat-input">
            <div class="input-group">
                <input id="messageInput" class="form-control" placeholder="Send a Message..." />
                
                <button id="sendButton" class="btn btn-primary">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </section>
    
    <!-- Online Users -->
    <aside class="user-sidebar">
        <div class="user-sidebar-header">
            <h5>
                <i class="bi bi-people"></i>
                Online Users
            </h5>
        </div>
        
        <div class="online-users">
            <div class="online-user">
                <span class="status-dot"></span>
                Nobody Online Yet
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/chat.js"></script>
}