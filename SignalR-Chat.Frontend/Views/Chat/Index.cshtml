@using SignalR_Chat.Shared.DTOs
@model SignalR_Chat.Frontend.ViewModels.ChatViewModel
@{
    ViewData["Title"] = "Chat";
}

<div class="container-fluid vh-100">
    <div class="row h-100">
        <!-- Conversations -->
        <div class="col-md-3 border-end p-3">
            <h5>Conversations</h5>
            
            <hr />
            
            <button class="btn btn-primary w-100 mb-2">
                <i class="bi bi-plus"></i>
                New Chat
            </button>
            
            <div class="list-group">
                <button class="list-group-item list-group-item-action">
                    General
                </button>
                
                <button class="list-group-item list-group-item-action">
                    Bob
                </button>
                
                <button class="list-group-item list-group-item-action">
                    Development
                </button>
            </div>
        </div>
        
        <!-- Chat Area -->
        <div class="col-md-6 d-flex flex-column p-0">
            <div class="border-bottom p-3">
                <h5>General</h5>
            </div>
            
            <div class="flex-grow-1 overflow-auto p-3">
                @foreach (MessageDto message in Model.CurrentConversation.Messages)
                {
                    <div class="chat-message mb-3">
                        <div>
                            <strong>@message.SenderUsername</strong>
                            <small class="text-muted ms-2">@message.SentAt.ToString("g")</small>
                        </div>
                        
                        <div>
                            @message.Content
                        </div>
                    </div>
                }
            </div>
            
            <div class="border-top p-3">
                <div class="input-group">
                    <input class="form-control" placeholder="Message..." />
                    
                    <button class="btn btn-primary">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Online Users -->
        <div class="col-md-3 border-start p-3">
            <h5>Online Users</h5>
            
            <hr />
            
            <p>
                <i class="bi bi-circle-fill text-success"></i>
                Bob
            </p>
            
            <p>
                <i class="bi bi-circle-fill text-success"></i>
                Alice
            </p>
        </div>
    </div>
</div>